---
import { PROJECTS, SITE } from "../config/site.config";

const waUrl = `https://wa.me/${SITE.whatsapp}?text=${encodeURIComponent(SITE.whatsappMessage)}`;
---

<section id="proyectos" class="py-24 border-t border-[var(--bg-border)]">
  <div class="max-w-6xl mx-auto px-6">
    <!-- Section header -->
    <div class="reveal mb-16 text-center">
      <span class="text-xs font-semibold tracking-widest uppercase text-[var(--accent)] mb-3 block">Portfolio</span>
      <h2 class="text-3xl md:text-4xl font-bold text-[var(--text-primary)]">
        {PROJECTS.sectionTitle}
      </h2>
    </div>

    <!-- Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {PROJECTS.items.map((project, index) => (
        <article
          class="reveal group rounded-xl border border-[var(--bg-border)] bg-[var(--bg-surface)] overflow-hidden hover:border-[var(--accent)] transition-all duration-300"
          style={`transition-delay: ${index * 0.1}s;`}
        >
          <!-- Image placeholder — TODO: reemplazar con <img> real -->
          <div class="relative aspect-video bg-[var(--bg)] flex items-center justify-center overflow-hidden border-b border-[var(--bg-border)]">
            <div class="absolute inset-0 opacity-5">
              <svg width="100%" height="100%">
                <defs>
                  <pattern id={`grid-${index}`} width="20" height="20" patternUnits="userSpaceOnUse">
                    <path d="M 20 0 L 0 0 0 20" fill="none" stroke="currentColor" stroke-width="0.5"/>
                  </pattern>
                </defs>
                <rect width="100%" height="100%" fill={`url(#grid-${index})`} />
              </svg>
            </div>
            <!-- TODO: reemplazar con imagen real del proyecto -->
            <span class="relative z-10 text-xs font-semibold tracking-widest uppercase text-[var(--text-subtle)]">
              {project.title}
            </span>
          </div>

          <!-- Content -->
          <div class="p-5">
            <!-- Category badge -->
            <span class="inline-block mb-3 px-2.5 py-1 rounded-md text-xs font-semibold border border-[var(--bg-border)] text-[var(--accent)]">
              {project.category}
            </span>

            <h3 class="text-base font-bold text-[var(--text-primary)] mb-2">
              {project.title}
            </h3>

            <!-- Result -->
            <p class="text-sm text-[var(--text-muted)] mb-4 flex items-start gap-2">
              <svg class="w-4 h-4 mt-0.5 flex-shrink-0 text-[var(--accent)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <polyline points="20 6 9 17 4 12"/>
              </svg>
              {project.result}
            </p>

            <a
              href="#contacto"
              class="inline-flex items-center gap-1 text-sm font-medium text-[var(--accent)] hover:gap-2 transition-all duration-200"
            >
              Ver más
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/>
              </svg>
            </a>
          </div>
        </article>
      ))}
    </div>

    <!-- CTA -->
    <div class="reveal mt-12 text-center" style="transition-delay: 0.3s;">
      <p class="text-[var(--text-muted)] mb-4">{PROJECTS.ctaText}</p>
      <a
        href={waUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-6 py-3.5 rounded-lg font-semibold text-base bg-[var(--accent)] text-[#0a0a0a] hover:bg-[var(--accent-hover)] transition-colors duration-200"
      >
        Conversemos
      </a>
    </div>
  </div>
</section>
